#!/bin/sh
# Docker + containers autostart for postmarketOS (local.d, last, script 95).
#
# Key facts discovered on this device (mainline 7.1.3-msm89x7):
#  - docker 29.x needs cgroup v1 "devices" controller mounted (cgroup v2 alone
#    fails with: "Devices cgroup isnt mounted")
#  - OpenRC cgroups service is unreliable at early boot here, and docker init
#    script "need cgroups" makes rc-service docker start fail with
#    "cgroups would not start". So we bypass OpenRC and start dockerd directly.
#  - docker is NOT in any runlevel; this script is the single owner.

LOG=/var/log/autostart-trace.log
echo "$(date +%F_%T) 95-docker start" >> $LOG

# 1) kernel modules
for m in overlay br_netfilter nf_nat nf_conntrack; do modprobe $m 2>/dev/null; done

# 2) mount cgroup v1 with devices controller (required by dockerd)
if ! mount | grep -q "cgroup_root"; then
    mount -t tmpfs -o mode=755 cgroup_root /sys/fs/cgroup 2>/dev/null
    for s in devices cpu cpuacct blkio freezer pids net_cls perf_event; do
        mkdir -p /sys/fs/cgroup/$s 2>/dev/null
        mount -t cgroup -o $s cgroup /sys/fs/cgroup/$s 2>/dev/null
    done
fi

# 3) start dockerd directly (idempotent: only if no socket)
if [ ! -S /var/run/docker.sock ]; then
    nohup /usr/bin/dockerd >/var/log/dockerd-direct.log 2>&1 &
fi
i=0
while [ ! -S /var/run/docker.sock ] && [ $i -lt 30 ]; do sleep 1; i=$((i+1)); done
if [ ! -S /var/run/docker.sock ]; then
    echo "$(date +%F_%T) FAILED: no docker socket" >> $LOG
    exit 0
fi
echo "$(date +%F_%T) dockerd ready" >> $LOG

# 4) start compose containers
cd /opt/dockersetup || exit 0
docker-compose up -d nginx >/dev/null 2>&1
if [ -f /opt/dockersetup/frpc/creds.env ] && ! grep -q "^TOKEN=REPLACE" /opt/dockersetup/frpc/creds.env 2>/dev/null; then
    docker-compose --env-file /opt/dockersetup/frpc/creds.env up -d frpc >/dev/null 2>&1
fi
NAMES=$(docker ps --format '{{.Names}}' 2>/dev/null | tr '\n' ' ')
echo "$(date +%F_%T) containers: $NAMES" >> $LOG
